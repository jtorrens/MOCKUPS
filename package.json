{
  "name": "mockups",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check:unused:desktop": "dotnet format src/Mockups.Desktop/Mockups.DesktopEditorShell.csproj style --verify-no-changes --severity info --diagnostics IDE0060 --no-restore",
    "check:architecture": "npm run validate:contracts && npm run validate:generated && npm run validate:pipeline && npm run validate:retired && npm run validate:architecture",
    "validate:contracts": "tsx scripts/validation/runValidationModule.ts contracts",
    "validate:generated": "tsx scripts/validation/runValidationModule.ts generated",
    "validate:pipeline": "tsx scripts/validation/runValidationModule.ts pipeline",
    "validate:retired": "tsx scripts/validation/runValidationModule.ts retired",
    "validate:architecture": "npm run test:architecture",
    "legacy:icon-theme:import": "tsx archive/react-legacy/src/icon-themes/importDevelopmentIconTheme.ts",
    "legacy:validate:examples": "tsx archive/react-legacy/src/domain/validation/validateExamples.ts",
    "legacy:validate:resolver": "tsx archive/react-legacy/src/domain/validation/validateResolver.ts",
    "legacy:validate:sqlite": "tsx archive/react-legacy/src/persistence/sqlite/validateSQLiteRepository.ts",
    "legacy:db:init": "tsx archive/react-legacy/src/persistence/sqlite/initializeDevelopmentDatabase.ts",
    "legacy:db:seed": "tsx archive/react-legacy/src/persistence/sqlite/seedDevelopmentDatabase.ts",
    "legacy:db:reset": "tsx archive/react-legacy/src/persistence/sqlite/resetDevelopmentDatabase.ts",
    "legacy:audit:current-model": "tsx archive/react-legacy/src/persistence/audit/auditCurrentModel.ts",
    "legacy:db:normalize-current-model": "tsx archive/react-legacy/src/persistence/audit/normalizeCurrentModel.ts",
    "desktop-preview:build": "node scripts/buildDesktopPreview.mjs",
    "desktop-preview:svg": "tsx scripts/renderDesignPreviewSvg.ts",
    "desktop": "dotnet run --project src/Mockups.Desktop.Host/Mockups.Desktop.Host.csproj",
    "desktop:mac": "tsx scripts/launchDesktopMac.ts --development",
    "desktop:compile": "dotnet build src/Mockups.Desktop.Host/Mockups.Desktop.Host.csproj",
    "desktop:build": "npm run desktop:compile",
    "desktop:db:create": "dotnet run --project src/Mockups.Desktop.Host/Mockups.Desktop.Host.csproj -- --create-current-database",
    "desktop:db:validate": "dotnet run --project src/Mockups.Desktop.Host/Mockups.Desktop.Host.csproj -- --validate-current-database",
    "desktop:publish:mac": "dotnet publish src/Mockups.Desktop.Host/Mockups.Desktop.Host.csproj -c Release -r osx-arm64 --self-contained true -o out/desktop/osx-arm64",
    "desktop:package:mac": "npm run desktop:publish:mac && node scripts/packageMacApp.mjs",
    "desktop:open:mac": "tsx scripts/launchDesktopMac.ts --packaged",
    "desktop:launch:mac": "npm run desktop:package:mac && npm run desktop:open:mac",
    "desktop:publish:win": "dotnet publish src/Mockups.Desktop.Host/Mockups.Desktop.Host.csproj -c Release -r win-x64 --self-contained true -o out/desktop/win-x64",
    "scaffold:component": "tsx scripts/scaffoldComponent.ts",
    "scaffold:generate": "tsx scripts/generateIntegratedComponentScaffoldArtifacts.ts",
    "scaffold:verify": "tsx scripts/verifyIntegratedComponentScaffolds.ts",
    "scaffold:module": "tsx scripts/scaffoldModule.ts",
    "scaffold:module:generate": "tsx scripts/generateIntegratedModuleScaffoldArtifacts.ts",
    "scaffold:module:verify": "tsx scripts/verifyIntegratedModuleScaffolds.ts",
    "app": "npm run desktop",
    "app:check": "npm run desktop:build",
    "app:build": "npm run desktop:build",
    "animation:test:preview": "tsx --test tests/animation/*.test.ts",
    "animation:test:desktop:core": "dotnet run --project tests/Mockups.Desktop.Tests/Mockups.DesktopEditorShell.AnimationTests.csproj -- --group core",
    "animation:test:desktop:ui": "dotnet run --project tests/Mockups.Desktop.Tests/Mockups.DesktopEditorShell.AnimationTests.csproj -- --group ui",
    "animation:test:desktop:exhaustive": "dotnet run --project tests/Mockups.Desktop.Tests/Mockups.DesktopEditorShell.AnimationTests.csproj -- --group exhaustive",
    "animation:test:desktop:owner": "dotnet run --project tests/Mockups.Desktop.Tests/Mockups.DesktopEditorShell.AnimationTests.csproj -- --group exhaustive",
    "animation:test:desktop": "npm run animation:test:desktop:core && npm run animation:test:desktop:ui && npm run animation:test:desktop:exhaustive",
    "animation:test": "npm run animation:test:preview && npm run animation:test:desktop",
    "test:focus:preview": "tsx --test",
    "test:focus:desktop": "dotnet run --project tests/Mockups.Desktop.Tests/Mockups.DesktopEditorShell.AnimationTests.csproj --",
    "test:guard": "npm run typecheck && npm run check:architecture && git diff --check",
    "test:scaffolding": "tsx --test tests/scaffolding/*.test.ts",
    "test:architecture": "tsx --test tests/architecture/*.test.ts",
    "test:tooling": "tsx --test tests/tooling/*.test.ts",
    "test:unit": "dotnet run --project tests/Mockups.Application.Tests/Mockups.Application.Tests.csproj",
    "test:repository": "tsx scripts/runRepositoryGates.ts",
    "test": "tsx scripts/runRepositoryValidation.ts",
    "test:cold": "dotnet clean src/Mockups.Desktop.Host/Mockups.Desktop.Host.csproj && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "fontkit": "^2.0.4",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
