<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>../Mockups.Desktop/app.manifest</ApplicationManifest>
    <MockupsRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</MockupsRepositoryRoot>
    <DesktopPreviewOutputDirectory>$(MockupsRepositoryRoot)/dist/desktop-preview</DesktopPreviewOutputDirectory>
    <DesktopPreviewSourceStamp>$(MockupsRepositoryRoot)/dist/desktop-preview.source.json</DesktopPreviewSourceStamp>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SukiUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Mockups.Application/Mockups.Application.csproj" />
    <ProjectReference Include="../Mockups.Desktop/Mockups.DesktopEditorShell.csproj" />
    <ProjectReference Include="../Mockups.Persistence.Sqlite/Mockups.Persistence.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mockups.DesktopEditorShell.AnimationTests" />
  </ItemGroup>

  <ItemGroup>
    <DesktopPreviewBuildInput Include="$(MockupsRepositoryRoot)/src/**/*.ts;$(MockupsRepositoryRoot)/src/**/*.tsx;$(MockupsRepositoryRoot)/src/desktop-preview/**/*.json;$(MockupsRepositoryRoot)/package.json;$(MockupsRepositoryRoot)/package-lock.json;$(MockupsRepositoryRoot)/tsconfig.json;$(MockupsRepositoryRoot)/scripts/buildDesktopPreview.mjs;$(MockupsRepositoryRoot)/scripts/desktopPreviewBuildInputs.mjs" />
    <Content Include="../../scripts/icon-themes/sync-icon-theme-token.cjs" Link="scripts/icon-themes/sync-icon-theme-token.cjs" CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="$(DesktopPreviewOutputDirectory)/manifest.json;$(DesktopPreviewOutputDirectory)/renderDesignPreviewHtml.cjs;$(DesktopPreviewOutputDirectory)/renderDesignPreviewHtml.cjs.map;$(DesktopPreviewOutputDirectory)/renderDesignPreviewHtmlServer.cjs;$(DesktopPreviewOutputDirectory)/renderDesignPreviewHtmlServer.cjs.map;$(DesktopPreviewOutputDirectory)/renderPreviewRasterServer.cjs;$(DesktopPreviewOutputDirectory)/renderPreviewRasterServer.cjs.map"
      Link="desktop-preview/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/system/system_icons/**/*.svg" Link="assets/system/system_icons/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target
    Name="BuildDesktopPreviewArtifacts"
    BeforeTargets="PrepareForBuild"
    Condition="'$(SkipDesktopPreviewBuild)' != 'true'"
    Inputs="@(DesktopPreviewBuildInput)"
    Outputs="$(DesktopPreviewOutputDirectory)/renderDesignPreviewHtml.cjs;$(DesktopPreviewOutputDirectory)/renderDesignPreviewHtml.cjs.map;$(DesktopPreviewOutputDirectory)/renderDesignPreviewHtmlServer.cjs;$(DesktopPreviewOutputDirectory)/renderDesignPreviewHtmlServer.cjs.map;$(DesktopPreviewOutputDirectory)/renderPreviewRasterServer.cjs;$(DesktopPreviewOutputDirectory)/renderPreviewRasterServer.cjs.map;$(DesktopPreviewSourceStamp)">
    <Exec
      WorkingDirectory="$(MockupsRepositoryRoot)"
      Command="node scripts/buildDesktopPreview.mjs --artifacts-only" />
  </Target>

  <Target
    Name="PrepareDesktopPreview"
    BeforeTargets="PrepareForBuild"
    DependsOnTargets="BuildDesktopPreviewArtifacts">
    <Exec
      Condition="'$(SkipDesktopPreviewBuild)' != 'true'"
      WorkingDirectory="$(MockupsRepositoryRoot)"
      Command="node scripts/buildDesktopPreview.mjs --manifest-only" />
    <Error
      Condition="!Exists('$(DesktopPreviewOutputDirectory)/manifest.json')"
      Text="Desktop Preview bundle manifest is missing. Build it with npm run desktop-preview:build or omit SkipDesktopPreviewBuild." />
  </Target>
</Project>
