{
  "schemaVersion": 1,
  "intent": {
    "responsibility": "Own one complete one-to-one or group video-call Screen.",
    "visualBoundary": "Own system chrome, optional header, participant layout, optional self view and optional call controls.",
    "runtimeBehavior": "Runtime owns call title, layout mode, self participant identity, control states and an ordered participant collection.",
    "forwarding": "Forward each participant collection item explicitly to the fixed Call Participant Variant and each control to its fixed Button Variant.",
    "temporalOwnership": "The Screen owns participant presence; every participant Runtime field is resolved relative to that participant first appearance.",
    "productionContext": "Use exact Screen → Shot → Actor → Theme/Device context."
  },
