{
  "schemaVersion": 1,
  "intent": {
    "responsibility": "Own a reusable media gallery that lays out Project media-directory contents as a centered carousel or vertically scrollable grid.",
    "visualBoundary": "Own one base Surface, its padded viewport, deterministic media cells, selection treatment and edge fade.",
    "runtimeBehavior": "Resolve the selected Project media directory, viewport size, selected item index and independent first visible gallery row.",
    "forwarding": "Forward each catalog item source and fixed fill-crop viewport values explicitly into the declared Media slots.",
    "temporalOwnership": "Selected index and first visible row are Component-owned Runtime values and animate on this Component timeline."
  },
