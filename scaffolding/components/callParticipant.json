{
  "schemaVersion": 1,
  "intent": {
    "responsibility": "Own one participant tile in a live video call.",
    "visualBoundary": "Own the participant Surface, Media, Avatar, status Label and name Label inside one assigned tile.",
    "runtimeBehavior": "Runtime owns the Actor, media, video availability, status override, microphone, connection and speaking state.",
    "forwarding": "Forward the exact Actor and Media values to fixed child Variant boundaries.",
    "temporalOwnership": "The parent owns participant presence; video availability and participant state tracks are relative to the participant first appearance."
  },
  "component": {
    "componentType": "callParticipant",
    "category": "component",
    "componentClassId": "component_project_foqn_s2_call_participant",
    "projectId": "project_foqn_s2",
